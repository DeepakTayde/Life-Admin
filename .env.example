# Environment Variables for Life Admin
# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_admin?schema=public"

# Authentication secret (generate with: openssl rand -base64 32)
AUTH_SECRET="super-secret-key-change-this-in-production-min-32-chars"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Gemini AI API Key for Document Extraction ("Add with AI")
GEMINI_API_KEY=""
